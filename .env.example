# ---------------------------------------------------------------------------
# Upstash Redis (optional, strongly recommended)
#
# A cold snapshot build touches ~250 third-party endpoints. With Redis the
# result is shared across instances and survives deploys, so a page view is a
# single cache read. Create a database at https://console.upstash.com/redis and
# copy the REST credentials.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Everything below is optional, and the app is fully usable with none of it
# set. Every data source this app reads — DefiLlama, Artemis, Mayan and the
# rest — is open and unauthenticated; the two keys here buy a better reading of
# two features, and both degrade quietly when absent.
# ---------------------------------------------------------------------------

# Optional. Developer mode's gas readings try public RPCs first and only fall
# back to Alchemy for the chains that answer unreliably. Unset, the feature
# still works on public endpoints alone.
ALCHEMY_API_KEY=

# Optional, and the only paid source in the app. Reads each headline as bullish
# or bearish for the news badge; about a cent to classify the whole corpus, and
# far less after that because verdicts are cached per headline. Unset, out of
# credit or rate limited, headlines fall back to the keyless badge that names
# the event instead. https://typesafe.ai
TYPESAFE_API_KEY=
