{
  "name": "par",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "next lint && tsc --noEmit",
    "dev": "next dev --turbo -p 3001",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "compare:cycles": "node --experimental-strip-types --import ./scripts/register-typescript.mjs scripts/cycle-forecast/compare.ts",
    "test:cycles": "node --experimental-strip-types --import ./scripts/register-typescript.mjs --test scripts/cycle-forecast/study.test.ts"
  },
  "dependencies": {
